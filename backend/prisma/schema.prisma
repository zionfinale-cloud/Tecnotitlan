// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Pooler para la app
  directUrl = env("DIRECT_URL") // Conexión directa para migraciones
}

// --- MODELOS DE LA APLICACIÓN ---

model User {
  id                          String                   @id @default(cuid())
  customerNumber              String?                  @unique @map("customer_number")
  firstName                   String                   @map("first_name")
  lastName                    String                   @map("last_name")
  secondLastName              String?                  @map("second_last_name")
  email                       String                   @unique
  password                    String
  countryCode                 String?                  @map("country_code")
  phone                       String?
  street                      String?
  neighborhood                String?
  city                        String?
  state                       String?
  postalCode                  String?                  @map("postal_code")
  isVerified                  Boolean                  @default(false) @map("is_verified")
  verificationToken           String?                  @map("verification_token")
  twoFactorEnabled            Boolean                  @default(false) @map("two_factor_enabled")
  twoFactorSecret             String?                  @map("two_factor_secret") @db.Text
  twoFactorRecoveryCodes      String[]                 @default([]) @map("two_factor_recovery_codes")
  tokenVersion                Int                      @default(0) @map("token_version")
  notificationEmailEnabled    Boolean                  @default(true) @map("notification_email_enabled")
  notificationWhatsappEnabled Boolean                  @default(false) @map("notification_whatsapp_enabled")
  notificationWhatsapp        String?                  @map("notification_whatsapp")
  role                        Role                     @relation(fields: [roleId], references: [id])
  roleId                      String
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  // Relaciones
  products                    Product[]
  orders                      Order[]
  reviews                     Review[]
  supportTickets              SupportTicket[]
  inventoryInvestments        InventoryInvestment[]
  inventoryMovements          InventoryMovement[]
  investmentCashMovements     InvestmentCashMovement[]
  tecatlConversations         ChatConversation[]
  tecatlHandoffs              ConversationHandoff[]    @relation("TecatlHandoffAssignee")
  permissionGrants            UserPermissionGrant[]
  permissionDenies            UserPermissionDeny[]
  meliIntegrations            MeliIntegration[]
  addresses                   CustomerAddress[]
  auditLogs                   AuditLog[]               @relation("AuditActor")

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?  @map("actor_email")
  action     String
  category   String   @default("GENERAL")
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  outcome    String   @default("SUCCESS")
  method     String?
  path       String?
  statusCode Int?     @map("status_code")
  ipHash     String?  @map("ip_hash")
  userAgent  String?  @map("user_agent") @db.Text
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([category, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model CustomerAddress {
  id           String   @id @default(cuid())
  label        String   @default("Principal")
  recipient    String   @map("recipient")
  phone        String
  street       String
  neighborhood String?
  city         String
  state        String
  postalCode   String   @map("postal_code")
  country      String   @default("Mexico")
  references   String?  @db.Text
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @map("user_id")

  @@index([userId])
  @@map("customer_addresses")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique // e.g., SUPER_ADMIN, VENDEDOR, USER
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id          String                @id @default(cuid())
  name        String                @unique // e.g., product:create, order:read
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  roles       Role[]
  userGrants  UserPermissionGrant[]
  userDenies  UserPermissionDeny[]

  @@map("permissions")
}

model UserPermissionGrant {
  userId       String     @map("user_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@map("user_permission_grants")
}

model UserPermissionDeny {
  userId       String     @map("user_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@map("user_permission_denies")
}

model Product {
  id                      String                 @id @default(cuid())
  sku                     String                 @unique
  name                    String
  shortDescription        String?                @map("short_description") @db.VarChar(280)
  gtin                    String?                @db.VarChar(14)
  description             String                 @db.Text
  price                   Float
  costPrice               Float?                 @default(0)
  brand                   String?
  countInStock            Int                    @default(0)
  productType             ProductType            @default(IN_HOUSE)
  supplierInfo            String?
  supplierStock           Int                    @default(0) @map("supplier_stock")
  supplierStockUnlimited  Boolean                @default(false) @map("supplier_stock_unlimited")
  supplierLeadTimeMinutes Int                    @default(60) @map("supplier_lead_time_minutes")
  shippingPayer           ShippingPayer          @default(CUSTOMER) @map("shipping_payer")
  shippingCostEstimate    Float?                 @default(0) @map("shipping_cost_estimate")
  weightKg                Float?                 @map("weight_kg")
  lengthCm                Float?                 @map("length_cm")
  widthCm                 Float?                 @map("width_cm")
  heightCm                Float?                 @map("height_cm")
  isArchived              Boolean                @default(false)
  rating                  Float                  @default(0)
  numReviews              Int                    @default(0)
  meliItemId              String?                @unique
  meliPublicationUrl      String?
  youtubeUrl              String?                @db.Text
  lastMeliSync            DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  // Relaciones
  user                    User                   @relation(fields: [userId], references: [id])
  userId                  String
  category                Category               @relation(fields: [categoryId], references: [id])
  categoryId              String
  media                   Media[]
  characteristics         Characteristic[]
  reviews                 Review[]
  orderItems              OrderItem[]
  inventoryMovements      InventoryMovement[]
  marketplaceListings     MarketplaceListing[]
  meliQuestions           MeliQuestion[]
  returnInspectionItems   ReturnInspectionItem[]

  @@map("products")
}

model AssistantProfile {
  id              String   @id @default(cuid())
  storeId         String   @default("default") @map("store_id")
  name            String   @default("Tecatl")
  avatarUrl       String?  @map("avatar_url") @db.Text
  tone            String   @default("amable, mexicano neutro, breve, confiable")
  welcomeMessage  String   @map("welcome_message") @db.Text
  fallbackMessage String   @map("fallback_message") @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([storeId])
  @@map("assistant_profiles")
}

model ChatConversation {
  id             String                 @id @default(cuid())
  storeId        String                 @default("default") @map("store_id")
  channel        ChatChannel
  customer       User?                  @relation(fields: [customerId], references: [id])
  customerId     String?                @map("customer_id")
  externalUserId String?                @map("external_user_id")
  customerName   String?                @map("customer_name")
  customerEmail  String?                @map("customer_email")
  status         ChatConversationStatus @default(OPEN)
  intent         String?
  lastMessageAt  DateTime?              @map("last_message_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  messages       ChatMessage[]
  handoffs       ConversationHandoff[]

  @@index([channel, status])
  @@index([customerId])
  @@index([lastMessageAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String           @map("conversation_id")
  role           ChatMessageRole
  content        String           @db.Text
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model KnowledgeArticle {
  id        String   @id @default(cuid())
  storeId   String   @default("default") @map("store_id")
  title     String
  category  String
  content   String   @db.Text
  tags      String[] @default([])
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category, isActive])
  @@map("knowledge_articles")
}

model ConversationHandoff {
  id             String                    @id @default(cuid())
  conversation   ChatConversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String                    @map("conversation_id")
  reason         String                    @db.Text
  status         ConversationHandoffStatus @default(OPEN)
  assignedUser   User?                     @relation("TecatlHandoffAssignee", fields: [assignedTo], references: [id])
  assignedTo     String?                   @map("assigned_to")
  createdAt      DateTime                  @default(now()) @map("created_at")
  resolvedAt     DateTime?                 @map("resolved_at")

  @@index([status, createdAt])
  @@map("conversation_handoffs")
}

model AssistantSetting {
  id        String   @id @default(cuid())
  storeId   String   @default("default") @map("store_id")
  key       String
  value     String   @db.Text
  type      String   @default("string")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, key])
  @@map("assistant_settings")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones jerárquicas
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  parentId String?
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@map("categories")
}

model Order {
  id                String                     @id @default(cuid())
  orderNumber       String                     @unique
  itemsPrice        Float
  shippingPrice     Float
  taxPrice          Float
  paymentFee        Float
  totalPrice        Float
  isPaid            Boolean                    @default(false)
  paidAt            DateTime?
  paymentMethod     String
  salesChannel      SalesChannel               @default(WEB) @map("sales_channel")
  isDelivered       Boolean                    @default(false)
  deliveredAt       DateTime?
  status            OrderStatus                @default(PENDING_PAYMENT)
  shippedAt         DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  // Relaciones y JSON
  user              User                       @relation(fields: [userId], references: [id])
  userId            String
  orderItems        OrderItem[]
  externalOrders    ExternalOrder[]
  shippingAddress   Json
  paymentResult     Json?
  shippingInfo      Json?
  statusHistory     StatusHistory[]
  notificationLogs  NotificationLog[]
  meliClaims        MeliClaim[]
  meliConversations MeliPostSaleConversation[]
  inboxLinks        UnifiedInboxLink[]
  returnInspections ReturnInspectionCase[]

  @@map("orders")
}

model MeliClaim {
  id                   String                @id @default(cuid())
  externalClaimId      String                @unique @map("external_claim_id")
  externalOrderId      String?               @map("external_order_id")
  sellerId             String?               @map("seller_id")
  type                 String?
  stage                String?
  status               String
  resource             String?
  resourceId           String?               @map("resource_id")
  reasonId             String?               @map("reason_id")
  reasonDetail         String?               @map("reason_detail") @db.Text
  title                String?
  description          String?               @db.Text
  problem              String?               @db.Text
  actionResponsible    String?               @map("action_responsible")
  dueDate              DateTime?             @map("due_date")
  affectsReputation    Boolean?              @map("affects_reputation")
  returnId             String?               @map("return_id")
  returnStatus         String?               @map("return_status")
  returnShipmentId     String?               @map("return_shipment_id")
  returnTrackingNumber String?               @map("return_tracking_number")
  returnCost           Float?                @map("return_cost")
  returnCurrency       String?               @map("return_currency")
  refundAt             String?               @map("refund_at")
  moneyStatus          String?               @map("money_status")
  internalStatus       String                @default("PENDING_REVIEW") @map("internal_status")
  priority             TicketPriority        @default(HIGH)
  assignedTo           String?               @map("assigned_to")
  inspectionStatus     String                @default("NOT_RECEIVED") @map("inspection_status")
  inspectionNotes      String?               @map("inspection_notes") @db.Text
  rawData              Json                  @map("raw_data")
  detailData           Json?                 @map("detail_data")
  messagesData         Json?                 @map("messages_data")
  returnData           Json?                 @map("return_data")
  historyData          Json?                 @map("history_data")
  resolutionsData      Json?                 @map("resolutions_data")
  lastSyncedAt         DateTime              @default(now()) @map("last_synced_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  order                Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId              String?               @map("order_id")
  activities           MeliClaimActivity[]
  returnInspection     ReturnInspectionCase?

  @@index([status, dueDate])
  @@index([internalStatus, priority])
  @@index([externalOrderId])
  @@index([orderId])
  @@map("meli_claims")
}

model MeliClaimActivity {
  id        String    @id @default(cuid())
  action    String
  actorId   String?   @map("actor_id")
  actorName String?   @map("actor_name")
  details   Json?
  createdAt DateTime  @default(now()) @map("created_at")
  claim     MeliClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  claimId   String    @map("claim_id")

  @@index([claimId, createdAt])
  @@map("meli_claim_activities")
}

model MeliQuestion {
  id                 String    @id @default(cuid())
  externalQuestionId String    @unique @map("external_question_id")
  itemId             String    @map("item_id")
  sellerId           String?   @map("seller_id")
  buyerId            String?   @map("buyer_id")
  status             String
  text               String    @db.Text
  answerText         String?   @map("answer_text") @db.Text
  answerStatus       String?   @map("answer_status")
  askedAt            DateTime? @map("asked_at")
  answeredAt         DateTime? @map("answered_at")
  assignedTo         String?   @map("assigned_to")
  internalStatus     String    @default("PENDING") @map("internal_status")
  rawData            Json      @map("raw_data")
  lastSyncedAt       DateTime  @default(now()) @map("last_synced_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  product            Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId          String?   @map("product_id")

  @@index([status, askedAt])
  @@index([internalStatus, updatedAt])
  @@index([itemId])
  @@index([productId])
  @@map("meli_questions")
}

model MeliPostSaleConversation {
  id               String                @id @default(cuid())
  packId           String                @unique @map("pack_id")
  sellerId         String                @map("seller_id")
  buyerId          String?               @map("buyer_id")
  status           String?
  substatus        String?
  unreadCount      Int                   @default(0) @map("unread_count")
  maxMessageLength Int                   @default(350) @map("max_message_length")
  assignedTo       String?               @map("assigned_to")
  internalStatus   String                @default("PENDING") @map("internal_status")
  lastMessageAt    DateTime?             @map("last_message_at")
  rawData          Json?                 @map("raw_data")
  lastSyncedAt     DateTime              @default(now()) @map("last_synced_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  order            Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId          String?               @map("order_id")
  messages         MeliPostSaleMessage[]

  @@index([unreadCount, lastMessageAt])
  @@index([internalStatus, updatedAt])
  @@index([orderId])
  @@map("meli_post_sale_conversations")
}

model MeliPostSaleMessage {
  id                String                   @id @default(cuid())
  externalMessageId String                   @unique @map("external_message_id")
  fromUserId        String?                  @map("from_user_id")
  toUserId          String?                  @map("to_user_id")
  direction         String
  status            String?
  moderationStatus  String?                  @map("moderation_status")
  text              String                   @db.Text
  sentAt            DateTime?                @map("sent_at")
  readAt            DateTime?                @map("read_at")
  attachments       Json?
  rawData           Json                     @map("raw_data")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  conversation      MeliPostSaleConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId    String                   @map("conversation_id")

  @@index([conversationId, sentAt])
  @@index([direction, readAt])
  @@map("meli_post_sale_messages")
}

model MeliCommunicationActivity {
  id         String   @id @default(cuid())
  entityType String   @map("entity_type")
  externalId String   @map("external_id")
  action     String
  actorId    String?  @map("actor_id")
  actorName  String?  @map("actor_name")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, externalId, createdAt])
  @@map("meli_communication_activities")
}

model UnifiedInboxLink {
  id         String   @id @default(cuid())
  sourceType String   @map("source_type")
  sourceId   String   @map("source_id")
  linkMethod String   @default("MANUAL") @map("link_method")
  confidence Int      @default(100)
  linkedById String?  @map("linked_by_id")
  linkedBy   String?  @map("linked_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String   @map("order_id")

  @@unique([sourceType, sourceId])
  @@index([orderId])
  @@map("unified_inbox_links")
}

model UnifiedInboxReply {
  id             String   @id @default(cuid())
  sourceType     String   @map("source_type")
  sourceId       String   @map("source_id")
  direction      String   @default("OUTBOUND")
  text           String   @db.Text
  deliveryStatus String   @default("SENT") @map("delivery_status")
  actorId        String?  @map("actor_id")
  actorName      String?  @map("actor_name")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([sourceType, sourceId, createdAt])
  @@map("unified_inbox_replies")
}

model InboxResponseTemplate {
  id         String   @id @default(cuid())
  name       String
  sourceType String?  @map("source_type")
  category   String   @default("GENERAL")
  body       String   @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([sourceType, isActive])
  @@map("inbox_response_templates")
}

model InboxQualityReview {
  id           String   @id @default(cuid())
  sourceType   String   @map("source_type")
  sourceId     String   @map("source_id")
  clarity      Int
  empathy      Int
  accuracy     Int
  resolution   Int
  compliance   Int
  overallScore Float    @map("overall_score")
  notes        String?  @db.Text
  reviewerId   String?  @map("reviewer_id")
  reviewer     String?  @map("reviewer")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([sourceType, sourceId, createdAt])
  @@index([overallScore, createdAt])
  @@map("inbox_quality_reviews")
}

model PageView {
  id           String   @id @default(cuid())
  path         String
  visitorHash  String   @map("visitor_hash")
  referrerHost String?  @map("referrer_host")
  source       String   @default("DIRECT")
  campaign     String?
  country      String?
  region       String?
  device       String?
  occurredAt   DateTime @default(now()) @map("occurred_at")

  @@index([occurredAt])
  @@index([path, occurredAt])
  @@index([source, occurredAt])
  @@index([country, occurredAt])
  @@index([visitorHash, occurredAt])
  @@map("page_views")
}

model ReturnInspectionCase {
  id                 String                 @id @default(cuid())
  caseNumber         String                 @unique @map("case_number")
  source             String                 @default("MANUAL")
  status             String                 @default("QUARANTINED")
  quarantineLocation String                 @map("quarantine_location")
  packageCondition   String?                @map("package_condition")
  sealedPackage      Boolean?               @map("sealed_package")
  receptionEvidence  Json?                  @map("reception_evidence")
  notes              String?                @db.Text
  receivedAt         DateTime               @default(now()) @map("received_at")
  receivedById       String?                @map("received_by_id")
  receivedBy         String?                @map("received_by")
  finalizedAt        DateTime?              @map("finalized_at")
  finalizedById      String?                @map("finalized_by_id")
  finalizedBy        String?                @map("finalized_by")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  order              Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId            String                 @map("order_id")
  claim              MeliClaim?             @relation(fields: [claimId], references: [id], onDelete: SetNull)
  claimId            String?                @unique @map("claim_id")
  items              ReturnInspectionItem[]

  @@index([status, receivedAt])
  @@index([orderId, createdAt])
  @@map("return_inspection_cases")
}

model ReturnInspectionItem {
  id             String               @id @default(cuid())
  expectedQty    Int                  @map("expected_qty")
  receivedQty    Int                  @map("received_qty")
  inspectedQty   Int                  @default(0) @map("inspected_qty")
  condition      String               @default("PENDING")
  disposition    String               @default("HOLD")
  serialNumbers  Json?                @map("serial_numbers")
  evidenceUrls   Json?                @map("evidence_urls")
  checklist      Json?
  notes          String?              @db.Text
  releasedQty    Int                  @default(0) @map("released_qty")
  releasedAt     DateTime?            @map("released_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  inspectionCase ReturnInspectionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId         String               @map("case_id")
  orderItem      OrderItem            @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  orderItemId    String               @map("order_item_id")
  product        Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId      String               @map("product_id")

  @@unique([caseId, orderItemId])
  @@index([productId, disposition])
  @@map("return_inspection_items")
}

model OrderItem {
  id                    String                 @id @default(cuid())
  name                  String
  qty                   Int
  image                 String?
  price                 Float
  unitCost              Float                  @default(0) @map("unit_cost")
  // Relaciones
  order                 Order                  @relation(fields: [orderId], references: [id])
  orderId               String
  product               Product                @relation(fields: [productId], references: [id])
  productId             String
  returnInspectionItems ReturnInspectionItem[]

  @@map("order_items")
}

model InventoryInvestment {
  id            String                   @id @default(cuid())
  name          String
  amount        Float
  notes         String?                  @db.Text
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  createdBy     User?                    @relation(fields: [createdById], references: [id])
  createdById   String?                  @map("created_by_id")
  movements     InventoryMovement[]
  cashMovements InvestmentCashMovement[]

  @@map("inventory_investments")
}

model InvestmentCashMovement {
  id           String                     @id @default(cuid())
  type         InvestmentCashMovementType
  amount       Float
  notes        String?                    @db.Text
  createdAt    DateTime                   @default(now()) @map("created_at")
  investment   InventoryInvestment        @relation(fields: [investmentId], references: [id])
  investmentId String                     @map("investment_id")
  createdBy    User?                      @relation(fields: [createdById], references: [id])
  createdById  String?                    @map("created_by_id")

  @@index([investmentId, createdAt])
  @@index([type, createdAt])
  @@map("investment_cash_movements")
}

model InventoryMovement {
  id            String                @id @default(cuid())
  type          InventoryMovementType
  quantity      Int
  unitCost      Float                 @default(0) @map("unit_cost")
  unitPrice     Float?                @map("unit_price")
  totalCost     Float                 @default(0) @map("total_cost")
  totalRevenue  Float?                @map("total_revenue")
  channel       SalesChannel?         @map("channel")
  stockBefore   Int                   @map("stock_before")
  stockAfter    Int                   @map("stock_after")
  referenceType String?               @map("reference_type")
  referenceId   String?               @map("reference_id")
  notes         String?               @db.Text
  createdAt     DateTime              @default(now()) @map("created_at")
  product       Product               @relation(fields: [productId], references: [id])
  productId     String                @map("product_id")
  investment    InventoryInvestment?  @relation(fields: [investmentId], references: [id])
  investmentId  String?               @map("investment_id")
  createdBy     User?                 @relation(fields: [createdById], references: [id])
  createdById   String?               @map("created_by_id")

  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([channel, createdAt])
  @@index([investmentId])
  @@map("inventory_movements")
}

model MarketplaceListing {
  id                   String                   @id @default(cuid())
  channel              SalesChannel
  externalProductId    String?                  @map("external_product_id")
  externalSku          String?                  @map("external_sku")
  title                String?
  price                Float?
  publishedStock       Int?                     @map("published_stock")
  stockBuffer          Int                      @default(0) @map("stock_buffer")
  commissionRate       Float?                   @map("commission_rate")
  fixedFee             Float                    @default(0) @map("fixed_fee")
  autoPrice            Boolean                  @default(true) @map("auto_price")
  shippingCostEstimate Float?                   @map("shipping_cost_estimate")
  status               MarketplaceListingStatus @default(DRAFT)
  syncStatus           String?                  @map("sync_status")
  lastSyncedAt         DateTime?                @map("last_synced_at")
  notes                String?                  @db.Text
  rawData              Json?                    @map("raw_data")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  product              Product                  @relation(fields: [productId], references: [id])
  productId            String                   @map("product_id")

  @@unique([productId, channel])
  @@index([channel, status])
  @@index([externalProductId])
  @@map("marketplace_listings")
}

model ExternalOrder {
  id              String       @id @default(cuid())
  channel         SalesChannel
  externalOrderId String       @map("external_order_id")
  externalStatus  String?      @map("external_status")
  customerName    String?      @map("customer_name")
  totalPrice      Float        @default(0) @map("total_price")
  shippingPrice   Float        @default(0) @map("shipping_price")
  feesEstimated   Float        @default(0) @map("fees_estimated")
  netRevenue      Float        @default(0) @map("net_revenue")
  orderedAt       DateTime?    @map("ordered_at")
  importedAt      DateTime     @default(now()) @map("imported_at")
  rawData         Json?        @map("raw_data")
  order           Order?       @relation(fields: [orderId], references: [id])
  orderId         String?      @map("order_id")

  @@unique([channel, externalOrderId])
  @@index([channel, importedAt])
  @@index([orderId])
  @@map("external_orders")
}

model Review {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Relaciones
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  product   Product  @relation(fields: [productId], references: [id])
  productId String

  @@unique([userId, productId])
  @@map("reviews")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  type        String   @default("string") // ej: 'string', 'color', 'boolean', 'textarea'
  description String?  @db.Text
  isEditable  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model TikTokShopIntegration {
  id                    String    @id @default(cuid())
  openId                String?   @map("open_id")
  sellerName            String?   @map("seller_name")
  sellerId              String?   @map("seller_id")
  shopName              String?   @map("shop_name")
  shopCipher            String?   @map("shop_cipher") @db.Text
  accessToken           String    @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  connectedBy           String?   @map("connected_by")
  rawData               Json?     @map("raw_data")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([openId])
  @@map("tiktok_shop_integrations")
}

model MeliIntegration {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  meliUserId   String?   @map("meli_user_id")
  nickname     String?
  accessToken  String    @map("access_token") @db.Text
  refreshToken String?   @map("refresh_token") @db.Text
  expiresIn    Int?      @map("expires_in")
  expiresAt    DateTime? @map("expires_at")
  tokenType    String?   @map("token_type")
  scope        String?   @db.Text
  rawData      Json?     @map("raw_data")
  connectedAt  DateTime  @default(now()) @map("connected_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([meliUserId])
  @@map("meli_integrations")
}

model TikTokShopWebhookEvent {
  id          String    @id @default(cuid())
  eventType   String?   @map("event_type")
  category    String?
  shopId      String?   @map("shop_id")
  shopCipher  String?   @map("shop_cipher") @db.Text
  messageId   String?   @unique @map("message_id")
  status      String    @default("RECEIVED")
  payload     Json
  headers     Json?
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  error       String?   @db.Text

  @@index([eventType, receivedAt])
  @@index([shopId])
  @@map("tiktok_shop_webhook_events")
}

// --- MODELOS AUXILIARES ---

model Counter {
  id            String @id
  sequenceValue Int    @default(0) @map("sequence_value")

  @@map("counters")
}

model Media {
  id        String    @id @default(cuid())
  type      MediaType
  url       String
  altText   String?
  product   Product   @relation(fields: [productId], references: [id])
  productId String

  @@map("media")
}

model Characteristic {
  id        String  @id @default(cuid())
  key       String
  value     String
  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@map("characteristics")
}

model StatusHistory {
  id      String   @id @default(cuid())
  status  String
  date    DateTime @default(now())
  notes   String?
  order   Order    @relation(fields: [orderId], references: [id])
  orderId String

  @@map("status_histories")
}

model SupportTicket {
  id           String              @id @default(cuid())
  ticketNumber String              @unique @map("ticket_number")
  name         String
  email        String
  phone        String?
  subject      String
  message      String              @db.Text
  source       SupportTicketSource @default(WEB)
  status       SupportTicketStatus @default(OPEN)
  priority     TicketPriority      @default(NORMAL)
  assignedTo   String?             @map("assigned_to")
  resolution   String?             @db.Text
  user         User?               @relation(fields: [userId], references: [id])
  userId       String?             @map("user_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([email])
  @@map("support_tickets")
}

model WhatsAppChat {
  id            String            @id @default(cuid())
  jid           String            @unique
  phone         String?
  name          String?
  lastMessage   String?           @map("last_message") @db.Text
  unreadCount   Int               @default(0) @map("unread_count")
  lastMessageAt DateTime?         @map("last_message_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  messages      WhatsAppMessage[]

  @@index([lastMessageAt])
  @@map("whatsapp_chats")
}

model WhatsAppMessage {
  id            String       @id @default(cuid())
  messageId     String?      @unique @map("message_id")
  direction     String
  fromMe        Boolean      @default(false) @map("from_me")
  text          String       @db.Text
  mediaUrl      String?      @map("media_url") @db.Text
  mediaType     String?      @map("media_type")
  mediaMimeType String?      @map("media_mime_type")
  fileName      String?      @map("file_name")
  status        String       @default("RECEIVED")
  sentBy        String?      @map("sent_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  chat          WhatsAppChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId        String       @map("chat_id")

  @@index([chatId, createdAt])
  @@map("whatsapp_messages")
}

model WhatsAppAuthFile {
  id           String   @id @default(cuid())
  provider     String   @default("baileys")
  relativePath String   @map("relative_path")
  content      Json
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([provider, relativePath])
  @@map("whatsapp_auth_files")
}

model WhatsAppAuthState {
  id        String   @id @default(cuid())
  provider  String   @default("baileys")
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, key])
  @@map("whatsapp_auth_state")
}

model NotificationLog {
  id          String                     @id @default(cuid())
  channel     NotificationChannel
  audience    NotificationAudience       @default(SYSTEM)
  event       String
  status      NotificationDeliveryStatus
  provider    String?
  recipient   String?
  orderId     String?                    @map("order_id")
  orderNumber String?                    @map("order_number")
  message     String?                    @db.Text
  error       String?                    @db.Text
  details     Json?
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")
  order       Order?                     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([channel, status, createdAt])
  @@index([orderId, createdAt])
  @@map("notification_logs")
}

// --- ENUMS ---

enum NotificationChannel {
  EMAIL
  WHATSAPP
  N8N
  SYSTEM
}

enum NotificationAudience {
  CUSTOMER
  STAFF
  ADMIN
  SYSTEM
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

enum ProductType {
  IN_HOUSE
  DROPSHIPPING
  SUPPLIER_ON_DEMAND
}

enum ShippingPayer {
  CUSTOMER
  SELLER
  MARKETPLACE
}

enum InventoryMovementType {
  PURCHASE
  SALE
  CHANNEL_TRANSFER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
}

enum InvestmentCashMovementType {
  CAPITAL_IN
  OPERATING_EXPENSE
  UNEXPECTED_EXPENSE
  CASH_OUT
  ADJUSTMENT_IN
}

enum SalesChannel {
  WEB
  MERCADOLIBRE
  TIKTOK_SHOP
  AMAZON
}

enum MarketplaceListingStatus {
  DRAFT
  READY
  ACTIVE
  PAUSED
  ERROR
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PROCESSING
  PENDING_FULFILLMENT
  SHIPPED
  DELIVERED
  CANCELLED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum SupportTicketSource {
  WEB
  EMAIL
  WHATSAPP
  BOT_ESCALATION
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ChatChannel {
  WEB
  WHATSAPP
  ADMIN
}

enum ChatConversationStatus {
  OPEN
  HUMAN_REQUIRED
  CLOSED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
  HUMAN
}

enum ConversationHandoffStatus {
  OPEN
  ASSIGNED
  RESOLVED
}
